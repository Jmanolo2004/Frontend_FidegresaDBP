# URL base del backend de Fidegresa (Spring Boot).
# En el celular no uses "localhost": pon la IP de tu PC en la red Wi-Fi (por ejemplo http://192.168.1.20:8080/api/v1)
# o la URL pública del backend desplegado.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8080/api/v1

# Geocodificador público para mostrar la dirección donde está el cajero (sin API key).
EXPO_PUBLIC_GEOCODER_URL=https://photon.komoot.io
