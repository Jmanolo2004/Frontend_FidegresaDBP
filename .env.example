# URL base del backend (Spring Boot). Ejemplo: https://api.fidegresa.com/api/v1
VITE_API_URL=http://localhost:8080/api/v1

# true: usa el servidor de demostración integrado (sin backend).
# false: todas las peticiones van al backend definido en VITE_API_URL.
VITE_USE_MOCK=true

# Estilo público de mapa (sin API key) y geocodificador de direcciones.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_GEOCODER_URL=https://photon.komoot.io/api
